{
  "name": "tessera",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-sqlite-lifecycle.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:integration": "npm run test:db",
    "test:sync": "vitest run tests/sync",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/foundation.spec.ts",
    "test:all": "npm run test:unit && npm run test:db && npm run test:sync && npm run test:native && npm run test:native-api && npm run test:e2e",
    "test:native": "cargo test --manifest-path src-tauri/sqlite-bridge/Cargo.toml --locked",
    "test:native-api": "node scripts/native-contract.mjs",
    "build": "npm run typecheck && npm run check:platforms && npm run licenses && vite build && node scripts/check-production.mjs",
    "build:desktop": "tauri build",
    "android:sync": "npm run build && cap sync android",
    "dev:android": "npm run android:sync && cap open android",
    "build:android": "npm run android:sync && node scripts/gradle.mjs :app:assembleDebug",
    "test:android": "npm run android:acceptance && node scripts/run-android-tests.mjs",
    "android:acceptance": "vite build --config vite.android-test.config.ts && cap sync android",
    "licenses": "node scripts/licenses.mjs",
    "tauri": "tauri",
    "test:scale": "vitest run tests/db/scale.test.ts --reporter=verbose",
    "check:platforms": "node scripts/check-platform-versions.mjs",
    "test:greenmail": "vitest run tests/mail/greenmail.test.ts --testTimeout=120000"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "entities": "9.0.0",
    "i18next": "27.1.1",
    "marked": "18.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
